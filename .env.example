# matches compose.yaml (`bun run db:up`); change the host/port/credentials for any other Postgres
DATABASE_URL=postgres://vision:vision@127.0.0.1:5432/vision

# Traceway (OTLP/HTTP): telemetry stays off until both are set. TOKEN = project ingest token (no `tws_` prefix)
TRACEWAY_URL=https://otel.dvgamerr.app
TRACEWAY_TOKEN=
